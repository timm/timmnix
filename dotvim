" Shared by vim and nvim: etc/nviminit.lua sources this file.
" A user vimrc stops vim loading its own defaults.  Re-source them, or
" we lose syntax, incsearch, ruler, wildmenu, backspace.  Must be first.
" nvim has no defaults.vim (and needs none), so skip it there.
if !has('nvim')
  unlet! skip_defaults_vim | source $VIMRUNTIME/defaults.vim
endif

colorscheme sorbet

set hidden                  " switch buffers with changes pending
set undofile                " undo survives :q
set undodir=~/.vim/undo
set relativenumber          " current line = 0, the rest relative
set clipboard=unnamed       " yank -> macOS pasteboard
set ignorecase smartcase    " /foo any case, /Foo exact
set expandtab shiftwidth=2 softtabstop=2
set textwidth=75            " gq reflows to here
set colorcolumn=75          " ...and here is the line showing it
set scrolloff=3
set path+=**                " :find name<Tab>, from the repo root
set laststatus=2            " else no status line with one window
if executable('rg') | set grepprg=rg\ --vimgrep | endif

" statusline: gran/parent/file, then vim's own flags and ruler.  @% is
" empty in a scratch buffer, where the dirs would be cwd fragments.
let &statusline = "%<%{@%=='' ? ''"
      \ . " : expand('%:p:h:h:t').'/'.expand('%:p:h:t').'/'}"
      \ . "%t %h%m%r%=%-14.(%l,%c%V%) %P"

set splitbelow splitright   " new splits open where the eye already is
set cursorline              " find the cursor in a long file
set title                   " buffer name into the terminal tab
set belloff=all             " vim 9 still beeps without this

let mapleader = ","
nnoremap <leader><space> :noh<cr>
nnoremap <leader>W :%s/\s\+$//<cr>:let @/=''<cr>
